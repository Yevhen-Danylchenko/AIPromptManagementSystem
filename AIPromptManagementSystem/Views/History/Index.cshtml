@model IEnumerable<AIPromptManagementSystem.Models.PromptUsageHistory>

@{
    ViewData["Title"] = "Історія промптів";
}

<div class="container mt-4">
    <h2 class="mb-3">Історія використання AI‑промптів</h2>

    <!-- Панель пошуку та фільтрації -->
    <form asp-action="Index" method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <input type="text" name="query" class="form-control" placeholder="Пошук за назвою або описом..." />
        </div>
        <div class="col-md-3">
            <select name="category" class="form-select">
                <option value="">-- Виберіть категорію --</option>
                @foreach (var cat in Enum.GetValues(typeof(AIPromptManagementSystem.Models.PromptCategoryEnum)))
                {
                    <option value="@cat">@cat</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <input type="text" name="aiTool" class="form-control" placeholder="Фільтр за AI‑інструментом..." />
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary">Фільтрувати</button>
        </div>
    </form>

    <!-- Кнопка сортування за рейтингом -->
    <div class="mb-3">
        <a asp-action="SortedByRating" class="btn btn-warning">Сортувати за рейтингом ↓</a>
    </div>

    <!-- Таблиця історії -->
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th scope="col">Назва</th>
                <th scope="col">Автор</th>
                <th scope="col">Категорія</th>
                <th scope="col">Інструмент</th>
                <th scope="col">Версія</th>
                <th scope="col">Середній рейтинг</th>
                <th scope="col">Дата використання</th>
                <th scope="col">Примітка</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.PromptTitle</td>
                    <td>@item.UserName</td>
                    <td>@item.Category</td>
                    <td>@item.AITool</td>
                    <td>@item.Version</td>
                    <td>
                        @if (item.AverageRating > 0)
                        {
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(item.AverageRating))
                                {
                                    <span class="text-warning">&#9733;</span>
                                }
                                else
                                {
                                    <span class="text-muted">&#9734;</span>
                                }
                            }
                            <span class="ms-2">(@item.AverageRating.ToString("0.0"))</span>
                        }
                        else
                        {
                            <span class="text-muted">Немає оцінок</span>
                        }
                    </td>
                    <td>@item.UsedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@item.ChangeNote</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">← Назад на головну</a>
    </div>
</div>


