@model IEnumerable<AIPromptManagementSystem.DTOs.PromptListDto>

@{
    ViewData["Title"] = "AI Prompts";
}

<div class="container mt-4">
    <h2 class="mb-3">Список AI‑промптів</h2>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th scope="col">Назва</th>
                <th scope="col">Категорія</th>
                <th scope="col">Інструмент</th>
                <th scope="col">Автор</th>
                <th scope="col">Версія</th>
                <th scope="col">Середній рейтинг</th>
                <th scope="col">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prompt in Model)
            {
                <tr>                    
                    <td>@prompt.Title</td>
                    <td>@prompt.Category</td>
                    <td>@prompt.AITool</td>
                    <td>@prompt.Author</td>
                    <td>@prompt.CurrentVersion</td>
                    <td>
                        @if (prompt.AverageRating > 0)
                        {
                            <!-- Вивід зірочок -->
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(prompt.AverageRating))
                                {
                                    <span class="text-warning">&#9733;</span>
                                }
                                else
                                {
                                    <span class="text-muted">&#9734;</span>
                                }
                            }
                            <span class="ms-2">(@prompt.AverageRating.ToString("0.0"))</span>
                        }
                        else
                        {
                            <span class="text-muted">Немає оцінок</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@prompt.Id" class="btn btn-sm btn-primary">Деталі</a>
                        <a asp-action="CreateVersion" asp-route-id="@prompt.Id" class="btn btn-sm btn-success">Нова версія</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

