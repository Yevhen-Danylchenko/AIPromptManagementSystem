@model AIPromptManagementSystem.DTOs.RatePromptDto

@{
    ViewData["Title"] = "Оцінити промпт";
}

<div class="container mt-4">
    <h2 class="mb-3">Оцінка AI‑промпта</h2>

    <form asp-action="Rate" method="post" class="needs-validation" novalidate>
        <input type="hidden" asp-for="PromptId" />

        <div class="mb-3">
            <label asp-for="UserName" class="form-label">Ваше ім’я</label>
            <input asp-for="UserName" class="form-control" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Rating" class="form-label">Оцінка (1–5)</label>
            <select asp-for="Rating" class="form-select">
                <option value="">-- Виберіть оцінку --</option>
                <option value="1">1 - Погано</option>
                <option value="2">2 - Слабко</option>
                <option value="3">3 - Нормально</option>
                <option value="4">4 - Добре</option>
                <option value="5">5 - Відмінно</option>
            </select>
            <span asp-validation-for="Rating" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Comment" class="form-label">Коментар (необов’язково)</label>
            <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Зберегти оцінку</button>
        <a asp-action="Details" asp-route-id="@Model.PromptId" class="btn btn-secondary ms-2">← Назад до деталей</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}




