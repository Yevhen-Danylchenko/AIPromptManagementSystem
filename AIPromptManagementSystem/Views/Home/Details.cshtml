@model AIPromptManagementSystem.DTOs.PromptDetailsDto

@{
    ViewData["Title"] = "Деталі промпта";
}

<div class="container mt-4">
    <h2 class="mb-3">Деталі AI‑промпта</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="card-title">@Model.Title</h4>
            <h6 class="card-subtitle mb-2 text-muted">Категорія: @Model.Category</h6>

            <p class="card-text"><strong>Інструмент:</strong> @Model.AITool</p>
            <p class="card-text"><strong>Автор:</strong> @Model.Author</p>
            <p class="card-text"><strong>Опис:</strong> @Model.Description</p>
            <p class="card-text"><strong>Версія:</strong> @Model.CurrentVersion</p>
            <p class="card-text"><strong>Дата створення:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
            <p class="card-text"><strong>Оновлено:</strong> @Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</p>

            <p class="card-text">
                <strong>Середній рейтинг:</strong>
                @if (Model.AverageRating > 0)
                {
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(Model.AverageRating))
                        {
                            <span class="text-warning">&#9733;</span>
                        }
                        else
                        {
                            <span class="text-muted">&#9734;</span>
                        }
                    }
                    <span class="ms-2">(@Model.AverageRating.ToString("0.0"))</span>
                }
                else
                {
                    <span class="text-muted">Немає оцінок</span>
                }
            </p>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">← Назад до списку</a>
        <a asp-action="Rate" asp-route-id="@Model.Id" class="btn btn-warning ms-2">Оцінити промпт</a>
        <a asp-action="CreateVersion" asp-route-id="@Model.Id" class="btn btn-success ms-2">Створити нову версію</a>
    </div>
</div>

